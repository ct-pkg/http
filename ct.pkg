# http - the libcurl (easy handle) HTTP client package.
#
# OO surface: `HttpRequest` owns one easy handle; configuration methods return
# the receiver, `post()` / `post_stream(cb, ud)` execute, `Drop` runs
# `curl_easy_cleanup` + `curl_slist_free_all`. `HttpResponse` is read-only.
#
# Secure defaults: TLS verification on, redirects off. The package does no
# connection pooling, retries, proxying or allow-listing.
#
# Requires the compiler line whose installer is the unified `ct` entry: `ct
# install` must print a `ct build` command with the package-root include
# (`-I vendor/http`). ct v0.49.0 still printed `ct-ast build`, so the install
# path documented in README fails there; v0.53.1 is the release this package is
# verified against (test/gates/p10_install.sh prints `install ok` and `200`).
name = http
publisher = ct
ns-root = .
version = 0.2.1
licence = MIT
ldflags = -lcurl
requires = ct >= 0.53.1
