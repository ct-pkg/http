import http::http;

#include <stdio.h>
#include "p4-server.h"

/*
 * The chain shape is frozen; only where the URL comes from changed once
 * send() started really performing (phase 4). The output is unchanged.
 */
int main(void)
{
    if (p4_server_start() != 0) return 1;
    char *url = p4_server_url("/200");

    int status = url
                     ->post()
                     ->header("Accept", "application/json")
                     ->timeout(3000)
                     ->send()
                     ->status();

    char *body = url
                     ->post()
                     ->header("Accept", "application/json")
                     ->send()
                     ->body();

    printf("%d %s\n", status, body);
    p4_server_stop();
    return 0;
}
