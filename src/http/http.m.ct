namespace http;

#include "http.shim.h"

/*
 * The public surface is this mapping unit, not the .h.ct types. Consumers
 * must `import http::http;`; importing only a type/constant unit leaves the
 * methods undiscoverable (`no method 'post' for type 'char *'`).
 */

pub type CRequest = struct HttpRequest;
pub type CResponse = struct HttpResponse;

/* Layer 1: a string only acts as a factory. */
pub trait HttpEntry {
    CRequest *post();
}

/* Layer 2: request configuration returns the receiver, so the chain keeps going. */
pub trait RequestBuilder {
    CRequest *header(char *name, char *value);
    CRequest *timeout(int ms);
    CRequest *connect_timeout(int ms);
    CRequest *body(char *data, int len);
    CRequest *user_agent(char *ua);
    CRequest *insecure(int on);
    CRequest *follow_redirects(int on);
    CResponse *send();
    void free();
}

/* Layer 3: the response is a read-only view with its own terminal release. */
pub trait ResponseView {
    int status();
    char *body();
    int body_len();
    int total_bytes();
    int error();
    char *error_msg();
    char *error_detail();
    int is_ok();
    int is_cancelled();
    char *take_body();
    void free();
}

map trait HttpEntry for type char * {
    post(s) -> http_request_new(s);
}

map trait RequestBuilder for type CRequest * {
    header(r, name, value)      -> http_request_header(r, name, value);
    timeout(r, ms)              -> http_request_timeout(r, ms);
    connect_timeout(r, ms)      -> http_request_connect_timeout(r, ms);
    body(r, data, len)          -> http_request_body(r, data, len);
    user_agent(r, ua)           -> http_request_user_agent(r, ua);
    insecure(r, on)              -> http_request_insecure(r, on);
    follow_redirects(r, on)     -> http_request_follow_redirects(r, on);
    send(r)                     -> http_request_send(r);
    free(r)                     -> http_request_release(r);
}

map trait ResponseView for type CResponse * {
    status(r)      -> http_response_status(r);
    body(r)        -> http_response_body(r);
    body_len(r)    -> http_response_body_len(r);
    total_bytes(r) -> http_response_total_bytes(r);
    error(r)       -> http_response_error(r);
    error_msg(r)   -> http_response_error_msg(r);
    error_detail(r) -> http_response_error_detail(r);
    is_ok(r)       -> http_response_is_ok(r);
    is_cancelled(r) -> http_response_is_cancelled(r);
    take_body(r)   -> http_response_take_body(r);
    free(r)        -> http_response_release(r);
}
